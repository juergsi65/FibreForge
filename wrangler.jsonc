{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fibreforge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,

  // Statische Dateien (JS fuer Karte und Admin-Bereich)
  "assets": { "directory": "./public" },

  // D1-Datenbank (in Cloudflare angelegt, Region Westeuropa)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fibreforge-db",
      "database_id": "ca62ba3d-eea8-4c2e-9861-37078feded7d",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Laendercode fuer die Suche nach Gemeindegrenzen (Nominatim/OpenStreetMap)
    "NOMINATIM_COUNTRY": "at"
  }
}
