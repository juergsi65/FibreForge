{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fibreforge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Statische Dateien (JS fuer Karte und Admin-Bereich)
  "assets": { "directory": "./public" },

  // D1-Datenbank. Die database_id nach `npx wrangler d1 create fibreforge-db` hier eintragen.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fibreforge-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Laendercode fuer die Suche nach Gemeindegrenzen (Nominatim/OpenStreetMap)
    "NOMINATIM_COUNTRY": "at"
  }
}
